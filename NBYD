<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BYD Color Codes | Official Paint Reference</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
  <style>
    .color-swatch { transition: all 0.3s; }
    .color-swatch:hover { transform: scale(1.08); box-shadow: 0 10px 25px rgba(0,0,0,0.3); }
    .hero-bg { background: linear-gradient(135deg, #0f172a, #1e2937); }
  </style>
</head>
<body class="bg-gray-950 text-white">
  <!-- Hero -->
  <header class="hero-bg py-20 text-center">
    <h1 class="text-6xl font-bold mb-4">BYD <span class="text-emerald-400">COLOR CODES</span></h1>
    <p class="text-xl text-gray-400 max-w-2xl mx-auto">Complete Paint & Color Reference for BYD Vehicles</p>
  </header>

  <div class="max-w-7xl mx-auto px-6 py-12">
    <!-- Search -->
    <div class="mb-10">
      <input type="text" id="search" placeholder="Search color name or code..." 
             class="w-full max-w-md px-6 py-4 bg-gray-900 border border-gray-700 rounded-2xl focus:outline-none focus:border-emerald-500 text-lg">
    </div>

    <!-- Color Grid -->
    <div id="color-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      <!-- Colors will be populated by JavaScript -->
    </div>
  </div>

  <footer class="bg-black py-8 text-center text-gray-500">
    <p>BYD Color Codes Reference • Not affiliated with BYD Auto</p>
  </footer>

  <script>
    // Sample BYD Colors (Add more from your PDF)
    const colors = [
      { name: "Skiing White", code: "WA2 / W36C", hex: "#F8F8F8" },
      { name: "Delan Black", code: "B1", hex: "#0A0A0A" },
      { name: "Harbour Grey", code: "HA4", hex: "#8C8C8C" },
      { name: "Atlantis Grey", code: "HB6", hex: "#4A5A6A" },
      { name: "Coral Pink", code: "KW", hex: "#FF8A9E" },
      { name: "Amethyst Purple", code: "CA2", hex: "#6B4E9E" },
      { name: "Surfing Blue", code: "UT", hex: "#00A1D6" },
      { name: "Time Grey", code: "HAZ", hex: "#A8A8A8" },
      // Add more colors from the PDF here
    ];

    function renderColors(filteredColors) {
      const grid = document.getElementById('color-grid');
      grid.innerHTML = '';
      
      filteredColors.forEach(color => {
        const div = document.createElement('div');
        div.className = `color-swatch bg-gray-900 rounded-3xl overflow-hidden border border-gray-800 cursor-pointer`;
        div.innerHTML = `
          <div class="h-48" style="background-color: ${color.hex};"></div>
          <div class="p-5">
            <h3 class="font-semibold text-lg">${color.name}</h3>
            <p class="text-emerald-400 text-sm">${color.code}</p>
            <p class="text-gray-400 font-mono text-xs mt-2">${color.hex}</p>
            <button onclick="copyHex('${color.hex}')" 
                    class="mt-3 text-xs px-4 py-2 bg-gray-800 hover:bg-emerald-600 rounded-full transition">
              Copy HEX
            </button>
          </div>
        `;
        grid.appendChild(div);
      });
    }

    function copyHex(hex) {
      navigator.clipboard.writeText(hex);
      alert('✅ ' + hex + ' copied to clipboard!');
    }

    // Search functionality
    document.getElementById('search').addEventListener('input', (e) => {
      const term = e.target.value.toLowerCase();
      const filtered = colors.filter(c => 
        c.name.toLowerCase().includes(term) || 
        c.code.toLowerCase().includes(term)
      );
      renderColors(filtered);
    });

    // Initial render
    renderColors(colors);
  </script>
</body>
</html>
